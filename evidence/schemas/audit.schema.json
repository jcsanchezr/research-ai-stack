{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aciatii.com/schemas/research-ai-stack/audit.schema.json",
  "title": "Research AI Stack Audit Record",
  "description": "Structured provenance record for independently verified agent executions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "milestone",
    "token",
    "input",
    "output",
    "transformation",
    "ecc_rules",
    "ecc_workflows",
    "verification"
  ],
  "properties": {
    "milestone": {
      "type": "string",
      "minLength": 1
    },
    "token": {
      "type": "string",
      "minLength": 1
    },
    "input": {
      "$ref": "#/$defs/artifact"
    },
    "output": {
      "$ref": "#/$defs/artifact"
    },
    "transformation": {
      "type": "string",
      "minLength": 1
    },
    "ecc_rules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "ecc_workflows": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "expected",
        "observed",
        "status"
      ],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "expected": {
          "type": "integer"
        },
        "observed": {
          "type": "integer"
        },
        "status": {
          "type": "string",
          "enum": ["PASS", "FAIL"]
        }
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
